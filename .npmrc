# Default registry — registry.npmjs.org has shown repeated integrity/reset
# failures from this build host (connection reset, tarball extraction
# failures, checksum mismatches on different packages each time). Mirror is
# generally more stable from this network path.
registry=https://registry.npmmirror.com/
@mid:registry=https://registry.midigi.id/
@aeroswarm:registry=https://registry.midigi.id/