# =====================================================================
# Database (packages/database) -- dipakai auth-service, notification-service,
# user-service. Gateway TIDAK butuh ini.
#
# Postgres-nya di VPS terpisah (bukan container lokal) -- DB_HOST/DB_PORT dipakai
# docker-compose untuk arahkan pgbouncer ke sana. DATABASE_URL dipakai kalau
# jalanin service langsung tanpa Docker (bun run dev), harus host yang sama.
# =====================================================================
DB_HOST=db.vps-anda.example.com
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=backend_djuanda

DATABASE_URL=postgresql://postgres:change-me@db.vps-anda.example.com:5432/backend_djuanda

# Tuning connection pool pg (default aman untuk 1 instance; kalau pakai PgBouncer
# di docker-compose, DATABASE_URL host di atas otomatis diarahkan ke pgbouncer)
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# =====================================================================
# Redis (packages/config) -- dipakai rate limiter (@repo/shared) & bullmq
# email queue (auth-service).
# =====================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
# Kosongkan kalau Redis tidak pakai auth (default di docker-compose kita).
REDIS_PASSWORD=

# =====================================================================
# Logging (packages/logger)
# =====================================================================
LOG_LEVEL=info

# =====================================================================
# Auth (auth-service) -- JWT_SECRET harus SAMA dengan punya gateway,
# karena gateway ikut memverifikasi token yang diterbitkan auth-service.
# =====================================================================
AUTH_SERVICE_PORT=3001
JWT_SECRET=change-me-to-a-long-random-secret

# Rate limit percobaan login (per username), dipakai auth-service
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Upload file (storage module di auth-service)
UPLOADTHING_SECRET=

# Email (email module di auth-service, belum ada trigger pemanggil)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password

# =====================================================================
# Services port
# =====================================================================
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
WORKER_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
ALERT_SERVICE_PORT=3006
ADVISORY_SERVICE_PORT=3007
WEATHER_SERVICE_PORT=3008
AERODROME_SERVICE_PORT=3009

# =====================================================================
# Advisory service -- NOTAM & ASHTAM (proxy NAVSIM).
#
# NOTAM/ASHTAM disinkronkan dari provider (auth lewat POST {BASE_URL}/api/token)
# secara berkala lalu disimpan ke tabel masing-masing. AFTN TIDAK lagi lewat
# sini — datanya stream dari AeroSwarm (lihat AEROSWARM_FLIGHTPLAN_*).
# Credential WAJIB dari env — jangan pernah ditulis di source code.
# =====================================================================
ADVISORY_PROVIDER_BASE_URL=http://provider-host:48765
ADVISORY_PROVIDER_USERNAME=change-me
ADVISORY_PROVIDER_PASSWORD=change-me
ADVISORY_PROVIDER_TIMEOUT_MS=20000
# Window sync digeser ke belakang sebanyak ini supaya message yang datang
# terlambat di provider tidak terlewat; duplicate-nya ditangani upsert.
ADVISORY_SYNC_OVERLAP_MS=300000
# Lifetime token dari advisory provider sebelum cache dianggap kadaluarsa
# (fallback kalau JWT tidak punya exp). Default 15 menit.
ADVISORY_PROVIDER_TOKEN_LIFETIME_MS=900000
# Sync berkala dinyalakan/dimatikan dan diatur per jenis (bawaan: aktif, tiap 30 menit).
# Interval harus kelipatan menit yang membagi 60 (atau kelipatan 60 menit) karena dipakai untuk cron.
# ADVISORY_NOTAM_SYNC_ENABLED=true
# ADVISORY_NOTAM_SYNC_INTERVAL_MS=1800000
# ADVISORY_ASHTAM_SYNC_ENABLED=true
# ADVISORY_ASHTAM_SYNC_INTERVAL_MS=1800000
# Klien NAVSIM (proxy NOTAM/ASHTAM). Bawaan di bawah.
# NAVSIM_BASE_URL=https://navsim.kemenhub.go.id/serv_bdg/api
# NAVSIM_TIMEOUT_MS=15000

# =====================================================================
# Connection service -- gambar live (WebSocket /ws/tracks/live), replay/
# history, dan penyimpanan track.
#
# Ada DUA cara data masuk. Pilih salah satu, atau keduanya selama masa validasi:
#
#   STANDALONE     Radar, MLAT, dan AFTN diterima LANGSUNG oleh process ini lewat
#                  UDP/TCP (@aeroswarm/ingest + codec). Tanpa service AeroSwarm.
#                  -> isi bagian B.
#   VIA AEROSWARM  Service AeroSwarm mengirim data ke sini lewat HTTP, WebSocket
#                  atau Kafka. Jalur lama; dihapus di task 09 setelah validasi.
#                  -> isi bagian C.
#
# Bagian A dipakai kedua cara. Awalan AEROSWARM_ pada nama env hanyalah nama
# lama: TIDAK berarti service AeroSwarm dibutuhkan. Yang dibutuhkan hanya paket
# @aeroswarm/* (dependency npm).
#
# Kalau dua cara hidup bersamaan (masa validasi), pakai DB dan topic Kafka yang
# TERPISAH dari AeroSwarm, kalau tidak track dan flight plan tersimpan ganda.
# Lihat docs/task/2026-10-31/11_validasi_dan_rollout.md.
# =====================================================================

# ---------------------------------------------------------------------
# A. UMUM -- dipakai standalone MAUPUN via AeroSwarm
# ---------------------------------------------------------------------
# Port HTTP + WebSocket. Nginx FE (/ws/tracks/live) dan gateway menunjuk ke
# sini, jadi jangan diubah tanpa mengubah keduanya.
CONNECTION_SERVICE_PORT=3005
# ICAO code of the airport THIS deployment serves (e.g. WARR) — scopes both
# inbound ingest validation and outbound /aero/* history/replay queries so a
# stray/misconfigured token or event from another airport can't read or
# write this airport's data. See docs/audit/tasks/006-*.md and 007-*.md in
# aeroswarm-project for why this matters even though today's topology is
# single-tenant (one backend-djuanda instance per airport).
AEROSWARM_AIRPORT_ID=WARR
# Token akses untuk live WebSocket (/ws/tracks/live) DAN replay/history (/aero/*),
# dipisah koma. Beberapa token boleh aktif bersamaan (rotasi: tambah yang baru,
# pindahkan klien, hapus yang lama). Pakai nilai acak panjang: `openssl rand -hex 24`.
# Kosong = semua koneksi ditolak. FE mengirimnya lewat `?token=` (WS) atau
# `Authorization: Bearer` (REST).
CONNECTION_API_TOKENS=
# Nama lama, masih dibaca dan digabung dengan CONNECTION_API_TOKENS.
AEROSWARM_MONITOR_TOKENS=
# Role yang boleh login di beberapa perangkat sekaligus (tanpa batas sesi per akun), dipisah koma. Bawaan: guest.
# Role lain tetap satu sesi: login baru memutus sesi sebelumnya. Kosong = tidak ada pengecualian.
# CONCURRENT_SESSION_ROLES=guest

# CORS untuk connection-service (dipanggil langsung oleh peramban) memakai CORS_ORIGIN yang sama dengan gateway dan
# worker-service (lihat bagian Gateway). Nama lama AEROSWARM_CORS_ORIGINS masih dibaca bila CORS_ORIGIN kosong.
# Origin yang tidak terdaftar tidak mendapat header CORS sama sekali.

# Live WebSocket (/ws/tracks/live): state track + server WS yang kompatibel
# dengan @aeroswarm/client, dijalankan di process ini (@aeroswarm/live-server).
# Semuanya opsional; kosong = default.
# Track diam: "stale" setelah STALE_AFTER_MS, "lost" setelah LOST_AFTER_MS, lalu
# dihapus setelah TRACK_REMOVE_AFTER_MS (0 = tidak pernah dihapus).
# STALE_AFTER_MS=15000
# LOST_AFTER_MS=90000
# TRACK_REMOVE_AFTER_MS=1800000
# Seberapa sering status dihitung ulang. WAJIB berjalan, kalau tidak track tidak
# pernah menjadi stale/lost.
# TRACK_SWEEP_MS=5000
# Batas push per klien per track (Hz) bila klien tidak meminta; heartbeat WS.
# WS_DEFAULT_UPDATE_HZ=10
# WS_HEARTBEAT_MS=15000
# Abaikan track di luar kotak ini kecuali sedang menuju ke dalamnya:
# "minLon,minLat,maxLon,maxLat" + lookahead (menit). Kosong = tanpa penyaringan.
# Nilai Juanda (WARR, ARP -7.3797 / 112.7868; kotak di sekitar ARP):
#   2.5 NM (9 km)   112.745,-7.421,112.829,-7.338   ~ batas tampilan peta FE (JuandaBound, 7 x 9 km)
#   5 NM  (19 km)   112.703,-7.463,112.871,-7.297
#   10 NM (37 km)   112.619,-7.546,112.955,-7.213   <- disarankan: final approach dan climb-out awal
#   20 NM (74 km)   112.451,-7.712,113.122,-7.047
# Lookahead 90 menit (bawaan) menampilkan semua pesawat yang menuju kotak, termasuk yang masih
# ratusan km jauhnya; 15 menit menampilkannya sekitar 15 menit sebelum tiba.
# INTEREST_BBOX=112.619,-7.546,112.955,-7.213
# INTEREST_LOOKAHEAD_MIN=15
# Pesawat yang sudah masuk kotak lalu keluar langsung hilang dari gambar (tidak menunggu stale 15 dtk,
# lost 90 dtk, dan hapus 30 menit). Menyala secara bawaan tetapi hanya bekerja bila INTEREST_BBOX diisi.
# Pesawat yang mendarat dan tetap di dalam kotak tidak terpengaruh.
# EXIT_REMOVE_ENABLED=true
# Jarak di luar kotak (m) sebelum dianggap keluar; meredam derau posisi di tepi supaya tidak berkedip. 0 = tanpa margin.
# EXIT_MARGIN_M=1000
# Jumlah laporan berturut-turut di luar margin sebelum dihapus. 1 (dengan margin 0) = seketika.
# EXIT_CONFIRM_FIXES=2
# Setelah dihapus, pesawat itu diabaikan sekian ms dari sensor mana pun supaya tidak muncul lagi sebagai hantu;
# sesudahnya aturan biasa berlaku, jadi pesawat yang kembali menuju bandara tampil lagi.
# EXIT_SUPPRESS_MS=600000

# --- Jejak pesawat (garis riwayat) ---
# GET /aero/tracks/:trackId/trail (token Bearer atau ?token=). Garis disusun di server dari memori,
# jadi FE hanya menggambar; label waktu dibuat server sesuai ?tz=Asia/Jakarta.
# TRAIL_ENABLED=true
# Satu titik tiap sekian meter (bukan tiap detik) supaya panjang garis konsisten; tikungan >= TRAIL_TURN_DEG tetap dicatat.
# TRAIL_MIN_DISTANCE_M=100
# TRAIL_TURN_DEG=10
# Selama pesawat diam/lambat tetap dicatat satu titik tiap sekian ms.
# TRAIL_MAX_GAP_MS=30000
# Batas memori: titik per pesawat (penuh -> setengahnya dijarangkan), jumlah pesawat, dan lama jejak disimpan setelah pesawat hilang.
# TRAIL_MAX_POINTS_PER_TRACK=20000
# TRAIL_MAX_TRACKS=5000
# TRAIL_RETAIN_AFTER_REMOVE_MS=300000
# Tanda waktu di garis tiap sekian ms (0 = tanpa tanda); batas titik bawaan bila permintaan tak menyebut limit.
# TRAIL_LABEL_EVERY_MS=120000
# TRAIL_DEFAULT_LIMIT=5000
# Bila memori tak punya jejaknya (pesawat sudah lama hilang) baca dari database.
# TRAIL_DB_FALLBACK=true
# Setelah proses restart, sambung bagian sebelum restart dari database sejauh sekian ms (lewat icao24). 0 = mati.
# Butuh indeks (data->'identity'->>'icao24', fused_at): migrasi 0025, dan di produksi jalankan dulu
# packages/database/drizzle/manual/0025_aeroswarm_tracks_icao24_fused.sql (CONCURRENTLY, tanpa mengunci tulis). Contoh: 3600000 (1 jam).
# TRAIL_BACKFILL_MS=0

# Outbound: connection-service republish fused tracks -> asmgcs.tracks
# untuk alert-service. Default dari docker-compose: redpanda:9092 /
# asmgcs.tracks. Baris di bawah dipakai saat jalan di luar Docker.
# AEROSWARM_TRACK_KAFKA_BROKERS=localhost:19092
# AEROSWARM_TRACK_KAFKA_TOPIC=asmgcs.tracks

# Wajib diisi kalau service redpanda dijalankan (docker-compose gagal start
# tanpa ini) -- alamat VPS ini yang bisa dijangkau producer di luar Docker
# (mis. AeroSwarm process-service; LAN atau IP publik, BUKAN localhost).
# Cek: `hostname -I` di VPS ini, verifikasi dari sisi producer: `nc -zv <IP> 19092`.
ADVERTISED_KAFKA_HOST=192.168.2.231

# ---------------------------------------------------------------------
# B. STANDALONE -- data diterima langsung, TANPA service AeroSwarm
#    Aktif hanya kalau port/host-nya diisi; yang kosong tidak dijalankan.
#    Jalur lain (HTTP/WS/Kafka ingest di bagian C) tetap bisa hidup di sebelahnya.
# ---------------------------------------------------------------------
# Radar / MLAT (ASTERIX) -- decode langsung via @aeroswarm/ingest + codec.
# UDP dan TCP bisa jalan bersamaan.
#
# UDP: listener, feed mengirim ke port ini. Diaktifkan dengan mengisi port.
# (Compose juga membuka port ini ke host; lihat komentar `ports:` di sana.)
# AEROSWARM_FEED_UDP_PORT=2026
# Bind address (default 0.0.0.0)
# AEROSWARM_FEED_UDP_HOST=0.0.0.0
# Identitas `source` pada track events yang dihasilkan feed ini
# AEROSWARM_FEED_SOURCE_ID=asterix-udp
# Whitelist kategori yang didecode jadi track (CAT23/34/63/19/247 selalu
# dilewatkan sebagai housekeeping — bukan track). Kosong = default di bawah.
# ASTERIX_ALLOWED_CATS=10,11,20,21,48,62
# Paksa edisi per kategori untuk varian non-standar: "21:2.4,48:1.21"
# ASTERIX_FORCED_EDITIONS=
# Koordinat radar site — WAJIB untuk CAT048 (posisi polar/cartesian dikonversi
# pakai titik ini; koordinat salah = semua target bergeser). Kosong = CAT048
# tanpa lat/lon di-skip.
RADAR_SITE_LAT=
RADAR_SITE_LON=
# Multicast — join group kalau feed kamu multicast (mis. 224.0.0.1). Kosong =
# unicast. Uji dulu: dukungan addMembership di Bun terbatas dibanding Node.
# AEROSWARM_FEED_MULTICAST_GROUP=
# AEROSWARM_FEED_MULTICAST_IFACE=
#
# TCP: backend bertindak sebagai CLIENT — connect keluar ke radar/gateway di
# host:port ini dan otomatis tersambung ulang (5 dtk). Keduanya wajib diisi.
# ASTERIX_TCP_HOST=
# ASTERIX_TCP_PORT=
# ASTERIX_TCP_SOURCE_ID=asterix-tcp
# Beberapa radar dalam satu stream, masing-masing dengan titiknya sendiri
# (kunci "sac:sic"); menimpa RADAR_SITE_LAT/LON untuk sensor itu.
# ASTERIX_RADAR_SITES={"50:176":{"lat":-7.38,"lon":112.78}}
#
# Banyak feed sekaligus (radar, MLAT, dst. di IP/port berbeda): array JSON,
# berjalan TAMBAHAN di atas UDP/TCP tunggal di atas. Yang tidak diisi mewarisi
# env bersama (airport, kategori, edisi, radar site). `name` harus unik; dua UDP
# tidak boleh memakai port + bindHost yang sama.
# ASTERIX_FEEDS=[{"name":"radar","transport":"udp","port":2026},{"name":"mlat","transport":"tcp","host":"10.0.0.5","port":2000,"allowedCats":[10,20],"radarSite":{"lat":-7.38,"lon":112.78}}]
#
# Penyimpanan track ke database (aeroswarm_tracks). Tiap sensor mengirim update sendiri, jadi satu track bisa berubah beberapa
# kali per detik, padahal riwayat, jejak, dan replay cukup sekitar satu posisi per detik. Satu baris disimpan per track paling
# sering sekali per sekian ms; perubahan yang berarti (lifecycle, callsign, jenis, status darat) langsung disimpan, dan track yang
# berakhir selalu disimpan. Hanya DB yang ditipiskan: peta realtime dan alert tetap menerima setiap update.
# 0 = simpan semuanya. Jumlah yang ditipiskan ada di metrik tracks_thinned_total.
# TRACK_STORE_MIN_INTERVAL_MS=1000

# Alert: satu pesawat satu track. Radar, ADS-B, dan MLAT yang belum menyatu (mis. sensor tanpa alamat Mode-S) menghasilkan beberapa
# track untuk satu pesawat, dan aturan alert membandingkan track satu sama lain (incursion terhadap dirinya sendiri). Sebelum aturan
# jalan, track dengan callsign (atau registrasi) yang sama disatukan, dan track tanpa nama yang menempel pada track bernama
# (jenis sama, jarak <= radius, selisih kecepatan <= batas) dianggap pesawat yang sama. Track yang dipilih tetap sama selama
# masih ada, supaya satu kejadian tetap satu alert. Radius 0 mematikan penilaian berdasar posisi. Jumlah yang disatukan ada di
# metrik alert_twin_tracks_merged_total.
# ALERT_TWIN_RADIUS_M=60
# ALERT_TWIN_MAX_SPEED_DIFF_KT=15

# Fusi: radar dan MLAT yang melihat pesawat yang sama digabung jadi SATU track
# (satu trackId, `sources` berisi semua sensor, lifecycle "merged"). Tanpa ini
# track tiap feed saling menggantikan di setiap update. Berlaku untuk feed
# langsung di bagian ini; ingest HTTP/WS/Kafka (bagian C) tidak lewat fusi.
# Dengan satu sensor saja hasilnya sama seperti tanpa fusi.
# Pencocokan: alamat Mode-S yang sama. Track tanpa alamat itu (kendaraan, radar
# SSR saja; id seperti "r50-176-42") hanya digabung kalau FUSION_SPATIAL=true.
# FUSION_ENABLED=true
# Sensor yang diutamakan untuk posisi, terbaik dulu. Isinya protocol
# ("asterix-cat010") atau nama feed ("mlat"). Di permukaan (onGround) memakai
# SURFACE, di udara memakai AIRBORNE. Bawaan: MLAT (CAT010/011/020) diutamakan
# di keduanya, lalu ADS-B (CAT021), lalu sistem track (CAT062) dan radar (CAT048).
# Untuk mendahulukan radar di udara: FUSION_AIRBORNE_PRIORITY=asterix-cat062,asterix-cat048,...
# FUSION_SURFACE_PRIORITY=asterix-cat010,asterix-cat011,asterix-cat020,asterix-cat021,asterix-cat062,asterix-cat048
# FUSION_AIRBORNE_PRIORITY=asterix-cat020,asterix-cat010,asterix-cat011,asterix-cat021,asterix-cat062,asterix-cat048
# Sensor yang diam lebih lama dari ini berhenti ikut menentukan posisi (5000),
# dan dilupakan setelah FUSION_FORGET_AFTER_MS (600000).
# FUSION_MAX_SOURCE_AGE_MS=5000
# FUSION_FORGET_AFTER_MS=600000
# Pencocokan berdasarkan posisi untuk track tanpa Mode-S (mati bawaan): dalam
# radius (150 m) dan selisih waktu (3000 ms). Ragu-ragu (lebih dari satu calon)
# = tidak digabung. Dua alamat Mode-S berbeda tidak pernah digabung.
# FUSION_SPATIAL=false
# FUSION_MATCH_RADIUS_M=150
# FUSION_MATCH_MAX_SKEW_MS=3000
# Dua sensor yang berjarak lebih dari ini dilaporkan berbeda pendapat (300);
# terlihat di /health (fusion.disagreements) dan di confidence.sourceAgreement.
# FUSION_DISAGREE_M=300

# AFTN / flight plan (sumber label arrival & departure)
# Pesan AFTN/ATS diterima langsung, dilipat jadi flight plan di memori (untuk
# label kuning/hijau di radar) dan diteruskan ke Kafka supaya advisory-service
# menyimpannya ke aftn_messages -- topic yang sama dengan yang dulu diisi AeroSwarm.
# UDP (satu pesan per datagram, listen di semua interface)
# AFTN_FEED_UDP_PORT=
# AFTN_FEED_SOURCE_ID=aftn-udp
# AFTN_FEED_MULTICAST_GROUP=
# AFTN_FEED_MULTICAST_IFACE=
# TCP: backend = CLIENT, connect keluar ke gateway AFTN dan tersambung ulang (5 dtk)
# AFTN_TCP_HOST=
# AFTN_TCP_PORT=
# AFTN_TCP_SOURCE_ID=aftn-tcp
# Banyak gateway sekaligus: array JSON, tambahan di atas dua di atas.
# AFTN_FEEDS=[{"name":"gw1","transport":"tcp","host":"10.0.0.7","port":9000}]
# Kafka tujuan (kosong = AEROSWARM_TRACK_KAFKA_BROKERS lalu KAFKA_BROKERS; semua
# kosong = AFTN hanya di memori, TIDAK sampai ke advisory-service).
# AFTN_KAFKA_BROKERS=
# AEROSWARM_FLIGHTPLAN_TOPIC=aeroswarm.flightplan.warr
# PERHATIAN saat AeroSwarm masih hidup: jangan biarkan dua penerbit menulis ke
# topic yang sama, pesan akan tersimpan ganda. Pakai topic berbeda selama paralel.

# ---------------------------------------------------------------------
# C. VIA AEROSWARM -- AeroSwarm mengirim data ke connection-service
#    Jalur lama. Hapus bagian ini (dan kodenya) di task 09 setelah validasi.
#    Tiga transport; lihat apps/connection-service/README.md untuk perbandingannya.
# ---------------------------------------------------------------------
# HTTP + WebSocket: shared secret ingest http (header x-aero-ingest-secret) dan
# websocket (?secret=) — samakan dengan config connector yang didaftarkan di AeroSwarm
AEROSWARM_INGEST_SECRET=change-me-ingest-secret

# Kafka ingest (opsional): buffer di broker (Redpanda), jadi restart/downtime
# connection-service tidak kehilangan data selama masih dalam retensi
# topic. Lihat service `redpanda`/`redpanda-init` di docker-compose.yml.
#
# AEROSWARM_INGEST_KAFKA_BROKERS dan _GROUP_ID di-hardcode oleh
# docker-compose.yml (redpanda:9092 / connection-service) -- TIDAK dibaca
# dari sini saat jalan lewat `docker compose up`. Baris di bawah cuma
# dipakai kalau connection-service dijalankan di luar Docker
# (`bun run dev`), di mana tidak ada suntikan env dari compose sama sekali.
# AEROSWARM_INGEST_KAFKA_BROKERS=localhost:19092
# AEROSWARM_INGEST_KAFKA_GROUP_ID=connection-service
#
# Ini SEBALIKNYA -- dibaca docker-compose.yml (redpanda-init & connection-service
# harus dapat nilai topic yang SAMA). Kosongkan untuk pakai default
# aeroswarm.ingest.warr.
AEROSWARM_INGEST_KAFKA_TOPIC=aeroswarm.ingest.warr

# =====================================================================
# Gateway -- satu-satunya service yang boleh diakses langsung dari luar
# =====================================================================
PORT=8080
# Origin FE yang boleh memanggil gateway. Satu origin, atau beberapa dipisah koma
# (mis. https://asmgcs.midigi.id,http://localhost:5173 untuk dev lokal ke server). "*" = semua origin
# (aman dipakai: auth lewat header Authorization, bukan cookie). Origin yang tidak terdaftar tidak
# mendapat header Access-Control-Allow-Origin sama sekali, dan browser menolak panggilannya.
CORS_ORIGIN=localhost

# Rate limit per-IP di edge (beda dari LOGIN_RATE_LIMIT_* di atas yang per-username)
RATE_LIMIT_MAX_ATTEMPTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# URL internal tiap service (dipakai gateway untuk proxy + health check /ready)
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3004
# worker-service melayani WebSocket dan SSE lewat gateway.
WS_SERVICE_URL=http://localhost:3003/ws
SSE_SERVICE_URL=http://localhost:3003/sse
ALERT_SERVICE_URL=http://localhost:3006
ADVISORY_SERVICE_URL=http://localhost:3007
CONNECTION_SERVICE_URL=http://localhost:3005
# Gateway memeriksa JWT login untuk /aero/tracks, lalu memakai token layanan ini ke connection-service.
# Kosong = token pertama dari CONNECTION_API_TOKENS, lalu AEROSWARM_MONITOR_TOKENS (.env yang sama sudah dibaca gateway).
# CONNECTION_SERVICE_TOKEN=
WEATHER_SERVICE_URL=http://localhost:3008
AERODROME_SERVICE_URL=http://localhost:3009
STATISTICS_SERVICE_URL=http://localhost:3010
PLAYBACK_SERVICE_URL=http://localhost:3011

# =====================================================================
# Kafka / Redpanda -- used by alert-service consumers and by
# advisory/weather/aerodrome producers. Comma-separated broker list.
# =====================================================================
KAFKA_BROKERS=localhost:19092

ALERT_KAFKA_BROKERS=localhost:19092
ALERT_KAFKA_TRACK_TOPIC=asmgcs.tracks
ALERT_KAFKA_ALERT_TOPIC=asmgcs.alerts
ALERT_KAFKA_ADVISORY_TOPIC=asmgcs.advisory
ALERT_KAFKA_WEATHER_TOPIC=asmgcs.weather
ALERT_KAFKA_AERODROME_TOPIC=asmgcs.aerodrome
ALERT_KAFKA_CONSUMER_GROUP=asmgcs-alert-service

# Anti-flicker tuning (alert-service). Alert yang kehilangan candidate-nya
# baru di-clear setelah selama ini tidak ke-refresh — meredam kedip dari
# jitter posisi di batas polygon & snapshot track antar-evaluasi paralel.
ALERT_STALE_GRACE_SECONDS=20
# Surface tetap dilaporkan OCCUPIED selama ini (ms) setelah track terakhir
# terlihat di dalamnya — meredam kedip highlight aerodrome di frontend.
ALERT_OCCUPANCY_STICKY_MS=5000

KAFKA_ADVISORY_TOPIC=asmgcs.advisory
KAFKA_WEATHER_TOPIC=asmgcs.weather
KAFKA_AERODROME_TOPIC=asmgcs.aerodrome
KAFKA_MOVEMENT_TOPIC=asmgcs.movement
# statistics-service membaca topic di atas dengan group ini.
# KAFKA_MOVEMENT_CONSUMER_GROUP=statistics-service-movement
# connection-service menunggu broker sekian ms saat mengirim event takeoff/landing.
# MOVEMENT_PRODUCER_SEND_TIMEOUT_MS=10000

# AFTN: advisory-service consume topic ini -> aftn_messages -> asmgcs.advisory.
# Topic dibuat oleh redpanda-init. Penerbitnya salah satu dari dua:
#   - standalone: connection-service (bagian B di atas, AFTN_FEED_* / AFTN_TCP_*)
#   - via AeroSwarm: connector di AeroSwarm (event aero.flightplan.v1)
# Jangan nyalakan keduanya ke topic yang sama (pesan tersimpan ganda).
# Set ENABLED "false" untuk mematikan consumer (mis. debug lokal).
AEROSWARM_FLIGHTPLAN_TOPIC=aeroswarm.flightplan.warr
AEROSWARM_FLIGHTPLAN_GROUP=asmgcs-advisory-aftn
AEROSWARM_FLIGHTPLAN_ENABLED=true

NOTIFICATION_KAFKA_BROKERS=localhost:19092
NOTIFICATION_KAFKA_ALERT_TOPIC=asmgcs.alerts
NOTIFICATION_KAFKA_CONSUMER_GROUP=asmgcs-notification-service

# =====================================================================
# Playback files (playback-service) -- blob .pbk hasil generate disimpan di
# MinIO; Postgres cuma menyimpan metadata-nya. Lihat service `minio` /
# `minio-init` di docker-compose.yml.
# =====================================================================
PLAYBACK_SERVICE_PORT=3011
# Port statistics-service (bawaan 3010).
# STATISTICS_SERVICE_PORT=3010
# Batas ukuran file .pbk yang diimpor, dalam byte (bawaan 500 MiB), dan selang kirim playback (ms).
# PLAYBACK_IMPORT_MAX_BYTES=524288000
# PLAYBACK_TICK_MS=500
# Root credential MinIO — MINIO_ROOT_PASSWORD WAJIB diisi (compose gagal
# start tanpa ini), minimal 8 karakter.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
# Bucket untuk file .pbk — dibuat otomatis oleh service minio-init.
PLAYBACK_BUCKET=playback-files
# Endpoint MinIO untuk playback-service yang jalan di luar Docker
# (`bun run dev`). Di docker-compose nilainya di-hardcode http://minio:9000.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-password
# Base URL yang bisa dijangkau browser untuk presigned upload/download —
# mis. https://files.asmgcs.midigi.id yang di-proxy TLS ke minio:9000.
# Kosong = presigned URL memakai MINIO_ENDPOINT apa adanya (hanya valid untuk
# client yang bisa resolve host itu — di compose hanya container lain).
MINIO_PUBLIC_ENDPOINT=
# Override image MinIO. Image resmi sudah ditarik dari Docker Hub DAN quay.io
# (Okt 2025) — default memakai arsip bitnamilegacy di Docker Hub. Kalau punya
# registry sendiri, mirror image ke sana lalu override di sini.
#MINIO_IMAGE=docker.io/bitnamilegacy/minio:2025.7.23
#MINIO_MC_IMAGE=docker.io/bitnamilegacy/minio-client:2025
# Limit memori container minio.
#MINIO_MEM_LIMIT=512m
# Bind address port API (9000). Default 0.0.0.0 — presigned URL dibuka
# langsung client. Set 127.0.0.1 kalau API di-proxy TLS (Caddy) + isi
# MINIO_SERVER_URL/MINIO_PUBLIC_ENDPOINT ke domain proxy itu.
#MINIO_API_BIND=127.0.0.1
#MINIO_SERVER_URL=https://minio.example.com
#MINIO_BROWSER_REDIRECT_URL=https://minio.example.com

# =====================================================================
# Seed / development only
# =====================================================================
# Set to production in real deployments. Seed scripts refuse to run in
# production unless ALLOW_PRODUCTION_SEED=1 is also set.
NODE_ENV=development

# Admin credentials used by packages/database/seed.ts. Hardcoded dev
# passwords are no longer supported. These are *development only*; set
# strong, non-default values for any non-local environment.
SEED_SUPERADMIN_EMAIL=admin@platform.com
SEED_SUPERADMIN_PASSWORD=change-me-superadmin
SEED_ADMIN_EMAIL=admin@tokoabc.com
SEED_ADMIN_PASSWORD=change-me-admin
BMKG_API_BASE_URL=https://web-aviation.bmkg.go.id/api/v1
BMKG_API_TOKEN=
# Stasiun cuaca dan perilaku pemanggilan BMKG (bawaan di bawah).
# WEATHER_STATION_ICAO=WARR
# PROVIDER_TIMEOUT_MS=5000
# PROVIDER_MAX_RETRIES=3
# PROVIDER_RETRY_BASE_DELAY_MS=1000
# Observasi lebih tua dari ini (menit) dianggap basi.
# OBSERVATION_STALE_MINUTES=45
# Token yang dikirim alert-service saat mengambil konteks cuaca lewat gateway (kosong = tanpa token).
# SERVICE_API_TOKEN=
METAR_POLL_INTERVAL_MS=1800000
SPECI_POLL_INTERVAL_MS=1800000
TAF_POLL_INTERVAL_MS=1800000
