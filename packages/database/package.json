{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle/drizzle.config.ts",
    "seed": "bun run seed.ts",
    "seed:alerts": "bun --env-file=../../.env run seed-alert-rules.ts"
  },
  "dependencies": {
    "@repo/logger": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
