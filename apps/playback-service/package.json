{
    "name":  "@repo/playback-service",
    "version":  "0.0.0",
    "private":  true,
    "main":  "./src/index.ts",
    "types":  "./src/index.ts",
    "exports":  {
                    ".":  "./src/index.ts",
                    "./ws-handler":  "./src/modules/ws/ws.handler.ts"
                },
    "scripts":  {
                    "dev":  "bun --env-file=../../.env run --hot src/index.ts",
                    "start":  "bun run src/index.ts",
                    "test":  "bun test",
                    "typecheck":  "tsc --noEmit",
                    "test:watch":  "bun test --watch",
                    "test:coverage":  "bun test --coverage --coverage-reporter=text"
                },
    "dependencies":  {
                         "@asteasolutions/zod-to-openapi":  "^8.5.0",
                         "@hono/swagger-ui":  "^0.6.1",
                         "@repo/auth":  "workspace:*",
                         "@repo/database":  "workspace:*",
                         "@repo/logger":  "workspace:*",
                         "@repo/shared":  "workspace:*",
                         "@repo/validation":  "workspace:*",
                         "@repo/config":  "workspace:*",
                         "drizzle-orm":  "^0.45.2",
                         "hono":  "^4.12.27",
                         "ioredis":  "^5.11.1",
                         "zod":  "^4.4.3",
                         "bullmq": "^5.79.2",
                         "minio": "^8.0.5"
                     }
}